---
import { Plasma } from './noise';
---

<Plasma client:only="react">
  <div class="z-[100] relative max-w-screen-xl mx-auto px-4 pt-[400px] h-full pb-16">
    <div class="flex w-full h-full md:flex-row flex-col-reverse gap-12 md:gap-0">
      <div class="flex flex-col items-center md:items-start md:justify-between h-full w-full">
        <p class="text-vista-gray-light text-[25px] text-shadow-lg text-shadow-black">
          made with <span class="text-vista-orange">{'<3'}</span> by <span class="text-vista-light"
            >vista</span
          >
        </p>
        <p class="text-vista-gray-light text-sm font-mono text-shadow-lg text-shadow-black">
          GET IN TOUCH: <span class="text-vista-light">INFO@VISTA.WTF</span>
        </p>
      </div>
      <div class="flex justify-center md:justify-end w-full gap-24">
        <div>
          <h4 class="text-[21px] text-vista-light mb-4">Navigation</h4>
          <div class="flex flex-col gap-4 font-mono text-vista-gray-light text-sm">
            <a href="#home" class="hover:text-vista-orange-light duration-300">HOME</a>
            <a href="#about" class="hover:text-vista-orange-light duration-300">ABOUT</a>
            <a href="#services" class="hover:text-vista-orange-light duration-300">SERVICES</a>
            <a href="#work" class="hover:text-vista-orange-light duration-300">WORK</a>
            <a href="#team" class="hover:text-vista-orange-light duration-300">TEAM</a>
          </div>
        </div>
        <div>
          <h4 class="text-[21px] text-vista-light mb-4">Socials</h4>
          <div class="flex flex-col gap-4 font-mono text-vista-gray-light text-sm">
            <a href="https://x.com/vistawtf" class="hover:text-vista-orange-light duration-300"
              >X (TWITTER)</a
            >
            <a href="https://github.com/vistawtf" class="hover:text-vista-orange-light duration-300"
              >GITHUB</a
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</Plasma>
